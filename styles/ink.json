{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Ink",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#161513" },
				{ "slug": "base-2", "name": "Base 2", "color": "#24221f" },
				{ "slug": "contrast", "name": "Contrast", "color": "#ece7dc" },
				{ "slug": "contrast-2", "name": "Contrast 2", "color": "#a9a297" },
				{ "slug": "accent", "name": "Accent", "color": "#f08a5d" },
				{ "slug": "accent-2", "name": "Accent 2", "color": "#3a2a22" }
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				":hover": {
					"color": { "background": "var:preset|color|contrast" }
				}
			}
		}
	}
}
