{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Sage",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#f3f5ef" },
				{ "slug": "base-2", "name": "Base 2", "color": "#e1e7d8" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1f2a1f" },
				{ "slug": "contrast-2", "name": "Contrast 2", "color": "#556152" },
				{ "slug": "accent", "name": "Accent", "color": "#3f6b3a" },
				{ "slug": "accent-2", "name": "Accent 2", "color": "#d3e2c7" }
			]
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"button": {
				"border": { "radius": "4px" }
			}
		}
	}
}
