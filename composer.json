{
	"name": "kennyb/block-starter",
	"description": "A starter WordPress block theme built around theme.json.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"BlockStarter\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"BlockStarter\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:unit": "phpunit --testsuite unit",
		"test:wp-env": "npx wp-env run tests-cli --env-cwd=wp-content/themes/block-starter env WP_PATH=/var/www/html vendor/bin/phpunit"
	}
}
